# Create a key in Vercel AI Gateway and copy it only to .env.local.
# Never commit a real credential.
AI_GATEWAY_API_KEY=

# Optional override for the V0 intake classifier.
AI_MODEL=openai/gpt-5.6-luna

# Required only when V2 case sessions are enabled. Keep this a long random secret.
CASE_SESSION_SIGNING_SECRET=

# Optional server-only V2 safety limits. Defaults are shown in the V1.5 contract.
CASE_SESSION_TTL_SECONDS=1800
CASE_SESSION_MAX_INPUT_TOKENS=12000
CASE_SESSION_MAX_WALL_CLOCK_MS=10000
CASE_SESSION_MAX_CLARIFICATIONS=2
